
# From https://my.telegram.org (API development tools). The first run asks for them and fills them in.
API_ID=
API_HASH=

# Default export directory; --output overrides it
DOWNLOAD_PATH=./exports

# Which kinds of file a run downloads
MEDIA_EXPORT_AUDIOS=False
MEDIA_EXPORT_VIDEOS=False
MEDIA_EXPORT_PHOTOS=True
MEDIA_EXPORT_STICKERS=True
MEDIA_EXPORT_ANIMATIONS=False
MEDIA_EXPORT_DOCUMENTS=False
MEDIA_EXPORT_VOICE_MESSAGES=False
MEDIA_EXPORT_VIDEO_MESSAGES=False
MEDIA_EXPORT_CONTACTS=False

# Which kinds of chat --all exports
CHAT_EXPORT_PERSONALS=False
CHAT_EXPORT_CHANNELS=False
CHAT_EXPORT_GROUPS=False
CHAT_EXPORT_SUPER_GROUPS=False
CHAT_EXPORT_CONTACTS=True
CHAT_EXPORT_BOTS=False

# FloodWait handling
FLOOD_WAIT_MAX_SLEEP=7200
DOWNLOAD_MAX_RETRIES=5

# Progress is saved to archive.db every CHECKPOINT_SECONDS; RESUME_ENABLED=False starts a fresh archive folder
CHECKPOINT_SECONDS=10
RESUME_ENABLED=True

# Stop (progress saved) when free space in the export directory drops below this
MIN_FREE_DISK_MB=2048
